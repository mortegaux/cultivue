# CultiVue Server Configuration

# Port the Express server listens on (default: 3000)
PORT=3000

# Path to the SQLite database file (default: data/cultivue.db)
DB_PATH=data/cultivue.db

# Environment mode: set to 'production' in live deployments for secure cookies and CSP
NODE_ENV=production

# Session cookie signing secret (recommended to set a long, random string in production)
# SESSION_SECRET=your_random_secret_here
